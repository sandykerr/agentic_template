    def test_development_alias_after_validation_cannot_follow_automatic_integration(graph):
        configure_plan(graph)
        with foreground(graph) as process:
            # Exclude setup checks; the first candidate is already tested when this
            # final destination read runs. This is the original Spec02 interleaving.
            wait_for(
                graph,
                process,
                lambda record: any(g["stage"] == "candidate" for g in record["gates"]),
            )
            with pause_after_git(process, ["for-each-ref", "--format=%(symref)", "refs/heads/dev"]):
                before = graph.git("show-ref")
                mutation = subprocess.run(
                    ["git", "-C", str(graph.repo), "symbolic-ref", "refs/heads/dev", "refs/heads/integration"],
                    capture_output=True,
                    text=True,
                )
                # A prepared transaction may already hold the destination locks. In
                # either ordering development must retain its original commit.
                assert mutation.returncode in (0, 1), mutation.stderr
                assert graph.git("show-ref") == before
            record = wait_for(
                graph,
                process,
                lambda record: record["outcome"] in ("incomplete", "awaiting_human_qa"),
            )
            assert graph.git("rev-parse", "dev") == graph.base
