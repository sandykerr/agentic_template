#!/usr/bin/env bash
# Check outgoing history, including files deleted in later commits.
set -euo pipefail

revisions=()
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deleting a remote ref sends no objects.
    if [[ "$local_oid" =~ ^0+$ ]]; then
        continue
    fi
    revisions+=("$local_oid")
    if [[ ! "$remote_oid" =~ ^0+$ ]] && git cat-file -e "$remote_oid" 2>/dev/null; then
        revisions+=("^$remote_oid")
    fi
done

if (( ${#revisions[@]} == 0 )); then
    exit 0
fi

printf '%s\n' "${revisions[@]}" |
    git rev-list --objects --stdin |
    git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' |
    awk '
        $1 == "blob" && $3 > 104857600 {
            print "Push blocked: Git blob exceeds 100 MiB: " $0 > "/dev/stderr"
            failed = 1
        }
        END {
            if (failed) {
                print "Compress/archive the file and remove its oversized blob from outgoing history." > "/dev/stderr"
            }
            exit failed
        }
    '
